# Seclusa Weather — security headers for Apache (.htaccess).
# Ignored by GitHub Pages. If you self-host on Apache, place this file at the
# document root (or merge the rules into your vhost config). It mirrors the
# <meta http-equiv="Content-Security-Policy"> already embedded in index.html /
# offline.html, but headers are the only way to make `frame-ancestors 'none'`
# (anti-clickjacking) actually take effect.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; connect-src https://api.open-meteo.com https://air-quality-api.open-meteo.com https://geocoding-api.open-meteo.com; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), gyroscope=(), magnetometer=(), accelerometer=(), payment=(), usb=(), midi=(), bluetooth=(), serial=(), interest-cohort=(), idle-detection=(), screen-wake-lock=(), picture-in-picture=(), fullscreen=(), clipboard-read=(), clipboard-write=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cache-Control "no-cache" "expr=%{REQUEST_URI} =~ m#^/index\.html$#"
  Header always set Cache-Control "no-cache" "expr=%{REQUEST_URI} =~ m#^/offline\.html$#"
  Header always set Cache-Control "no-cache" "expr=%{REQUEST_URI} =~ m#^/sw\.js$#"
</IfModule>